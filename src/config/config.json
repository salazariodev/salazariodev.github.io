{
  "site": {
    "title": "SalazarioDev",
    "base_url": "https://salazariodev.com",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/s-favicon.png",
    "logo": "/images/s-logo.png",
    "logo_darkmode": "/images/s-logo-darkmode.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "SalazarioDev",
    "description": "Aprende automatización con n8n, No-Code e IA. Guías para hacerlo tú mismo… y flujos ya construidos si prefieres solo disfrutar el resultado."
  },

  "settings": {
    "search": true,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },

  "announcement": {
    "enable": true,
    "content": "<span class='text-center block'>🤖 ¿Procesos repetitivos en tu negocio? Los automatizo con n8n → <a class='underline font-semibold' href='/contact' rel='noopener'>Agenda una demo gratis</a></span>",
    "expire_days": 7
  },

  "params": {
    "contact_form_action": "#",
    "copyright": "Designed And Developed by [Zeon Studio](https://zeon.studio)"
  },

  "navigation_button": {
    "enable": true,
    "label": "Github",
    "link": "https://github.com/zeon-studio/astroplate"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "zeon.studio",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind boilerplate"
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
